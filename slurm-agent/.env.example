# ─────────────────────────────────────────────────────────────────
# Slurm Agent — environment configuration example
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────────
# "ollama"   → local Ollama (default)
# "copilot"  → GitHub Copilot API (Claude Sonnet — requires GITHUB_TOKEN)
LLM_PROVIDER=ollama

# ── GitHub Copilot settings (only needed when LLM_PROVIDER=copilot) ──
# GitHub personal access token with the `copilot` scope.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Copilot API base URL (default is fine for most users)
COPILOT_BASE_URL=https://api.githubcopilot.com

# Model name to use with the Copilot API
COPILOT_MODEL=claude-sonnet-4-5

# ── Ollama settings (only needed when LLM_PROVIDER=ollama) ───────
SLURM_AGENT_MODEL=qwen3.5:9b
SLURM_AGENT_SPECIALIST_MODEL=qwen2.5:7b
SLURM_AGENT_JUDGE_MODEL=gpt-oss:20b
SLURM_AGENT_BASE_URL=http://localhost:11434/v1

# ── MCP Server ───────────────────────────────────────────────────
# MCP_URL=http://localhost:3002

# ── Auto-approve mode ────────────────────────────────────────────
# When true, dangerous tools (sbatch, scancel, shell_exec, etc.)
# are executed without asking the user for confirmation.
# Like Copilot's "yolo mode" — useful for demos and trusted environments.
# AUTO_APPROVE=false
