graph LR
    subgraph OBSERVER["🔵 OBSERVER (entry point)"]
        direction TB
        A[User Request] --> B{Classify Intent}
        B -->|Read-only| C[Read MCP Tools\nanalysis + safe subset]
        C --> R[Final Response]
        L2[Receive Operator Results] --> B2{More actions needed?}
        B2 -->|No| R
    end

    subgraph OPERATOR["🟠 OPERATOR"]
        direction TB
        E{target_scope?}
        E -->|discovery| F[Discovery Read\nsqueue / scontrol_show]
        F --> G[Action FunctionTool\nneeds_approval=True]
        E -->|explicit| G
        G --> H{HITL Gate\nauto_approve=False?}
        H -->|Approved| I[Execute via MCP]
        H -->|Cancelled| J[Discard]
    end

    B -->|"State-changing"| D["SDK handoff()\n→ Operator\n(action, tool, targets, scope)"]
    D --> E
    I --> L["SDK handoff()\n→ Observer\n(results)"]
    J --> L
    L --> L2
    B2 -->|"Yes"| D
