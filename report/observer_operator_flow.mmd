graph LR
    subgraph OBSERVER["🔵 OBSERVER"]
        direction TB
        A[User Request] --> B{Classify Intent}
        B -->|Read-only| C[Read MCP Tools]
        C --> R[Response to User]
        L2[Receive Results] --> B2{More actions needed?}
        B2 -->|No| R
    end

    subgraph OPERATOR["🟠 OPERATOR"]
        direction TB
        E{target_scope?}
        E -->|discovery| F[Discovery Read]
        F --> G[Action Tool]
        E -->|explicit| G
        G --> H{HITL Confirm?}
        H -->|Approve| I[Execute]
        H -->|Cancel| J[Discard]
    end

    B -->|"State-changing"| D["transfer_to_operator<br/>(action, tool, targets, scope)"]
    D --> E
    I --> L["transfer_to_observer<br/>(results)"]
    J --> L
    L --> L2
    B2 -->|"Yes"| D
